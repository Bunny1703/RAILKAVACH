# Copy this file to .env and fill in your own values.
# NEVER commit .env or share its contents.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# If your Supabase project uses the older key name, use this instead:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_EMAILS=your-email@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

PORT=3000

# Optional: bypass broken local DNS by specifying a reachable Supabase IPv4.
# SUPABASE_IPV4=172.64.149.246
NODE_ENV=development

# Production: use a random secret with at least 32 characters
# SESSION_SECRET=generate-a-long-random-secret-here

# Optional custom railway-defect YOLO weights
YOLO_MODEL_PATH=ml/model/railway_defect_yolo.pt
PYTHON_BIN=python
